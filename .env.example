# MindForge single source of runtime configuration.
# Copy to .env and replace secret placeholders before deployment.

# Application
MINDFORGE_PROJECT_ROOT=.
MINDFORGE_DATA_DIR=data
MINDFORGE_TRACES_DIR=data/traces
MINDFORGE_SEMANTIC_MEMORY_DIR=data/semantic-memory
MINDFORGE_LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173
API_MAX_UPLOAD_MB=200
API_MAX_TEXT_FILE_MB=20
API_MAX_PARSED_CHARS=5000000
API_MAX_PDF_PAGES=600
API_MAX_DOCX_UNCOMPRESSED_MB=100
API_MAX_DOCX_PARTS=5000
API_MAX_CHUNKS_PER_DOCUMENT=2000
API_INDEX_BATCH_SIZE=128
API_MAX_CONCURRENT_INDEX_JOBS=1
API_PDF_PARSE_EXECUTOR=process
API_PDF_PARSE_WORKERS=12
API_PDF_PARALLEL_PAGE_THRESHOLD=10
API_PDF_PARSE_BATCH_PAGES=8
API_HEALTH_REFRESH_SECONDS=15
API_MAX_HISTORY_ENTRIES=1000
API_ALLOW_LOCAL_FILE_INDEX=false

# LLM provider: openai | deepseek | openai_compatible | local
LLM_LLM_PROVIDER=deepseek
LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Generic OpenAI-compatible cloud API
LLM_COMPATIBLE_API_KEY=
LLM_COMPATIBLE_BASE_URL=
LLM_COMPATIBLE_API_KEY_REQUIRED=true
LLM_COMPATIBLE_MODEL=
LLM_COMPATIBLE_PLANNER_MODEL=
LLM_COMPATIBLE_RESEARCHER_MODEL=
LLM_COMPATIBLE_CRITIC_MODEL=
LLM_COMPATIBLE_SYNTHESIZER_MODEL=
LLM_COMPATIBLE_SUPPORTS_TOOLS=true
LLM_COMPATIBLE_SUPPORTS_JSON_MODE=true
LLM_COMPATIBLE_SUPPORTS_JSON_SCHEMA=false

# Self-hosted OpenAI-compatible service (vLLM, Ollama, LM Studio)
LLM_LOCAL_API_KEY=
LLM_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
LLM_LOCAL_API_KEY_REQUIRED=false
LLM_LOCAL_MODEL=
LLM_LOCAL_PLANNER_MODEL=
LLM_LOCAL_RESEARCHER_MODEL=
LLM_LOCAL_CRITIC_MODEL=
LLM_LOCAL_SYNTHESIZER_MODEL=
LLM_LOCAL_SUPPORTS_TOOLS=true
LLM_LOCAL_SUPPORTS_JSON_MODE=true
LLM_LOCAL_SUPPORTS_JSON_SCHEMA=false

# Role-specific models
LLM_PLANNER_MODEL=gpt-4o
LLM_RESEARCHER_MODEL=gpt-4o-mini
LLM_CRITIC_MODEL=gpt-4o
LLM_SYNTHESIZER_MODEL=gpt-4o
LLM_DEEPSEEK_PLANNER=deepseek-chat
LLM_DEEPSEEK_RESEARCHER=deepseek-chat
LLM_DEEPSEEK_CRITIC=deepseek-chat
LLM_DEEPSEEK_SYNTHESIZER=deepseek-chat
LLM_DEEPSEEK_EMBEDDING=BAAI/bge-m3

# Embedding: openai | bge
LLM_EMBEDDING_PROVIDER=bge
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIM=1024
LLM_LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LLM_LOCAL_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
LLM_LOCAL_EMBEDDING_DIM=1024
LLM_HF_ENDPOINT=https://hf-mirror.com
LLM_HF_HUB_DOWNLOAD_TIMEOUT=30
LLM_SENTENCE_TRANSFORMERS_DEVICE=cpu
LLM_EMBEDDING_BATCH_SIZE=32
LLM_TORCH_NUM_THREADS=0

# Qdrant
VECTOR_QDRANT_URL=http://localhost:6333
VECTOR_QDRANT_API_KEY=
VECTOR_COLLECTION_NAME=mindforge_docs
VECTOR_EMBEDDING_DIM=1024
VECTOR_MAX_SCROLL_RECORDS=100000

# Retrieval and persistent auxiliary indexes
RETRIEVAL_VECTOR_TOP_K=20
RETRIEVAL_BM25_TOP_K=20
RETRIEVAL_RERANK_TOP_K=6
RETRIEVAL_MAX_REQUEST_TOP_K=50
RETRIEVAL_RERANKER_MAX_CANDIDATES=100
RETRIEVAL_BM25_MAX_CHUNKS=100000
RETRIEVAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RETRIEVAL_RERANKER_DEVICE=cpu
RETRIEVAL_RERANKER_PRELOAD=true
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_BM25_INDEX_DIR=data/bm25

# Chunking
CHUNK_CHUNK_SIZE=512
CHUNK_CHUNK_OVERLAP=64
CHUNK_USE_SEMANTIC_CHUNKING=false

# Adaptive document parser
PARSER_MODE=auto
PARSER_OCR_ENABLED=true
PARSER_OCR_PROVIDER=paddle
PARSER_OCR_LANGUAGE=ch
PARSER_OCR_DEVICE=cpu
# PaddleOCR defaults to Hugging Face. BOS works in the deployed network.
PARSER_OCR_MODEL_SOURCE=BOS
# The current CPU Paddle runtime requires this compatibility fallback.
PARSER_OCR_ENABLE_MKLDNN=false
PARSER_OCR_DPI=200
PARSER_OCR_MIN_NATIVE_TEXT_CHARS=30
PARSER_OCR_MIN_PRINTABLE_RATIO=0.65
PARSER_OCR_MAX_PAGES=600
PARSER_LAYOUT_ENABLED=true
PARSER_TABLE_EXTRACTION_ENABLED=true
PARSER_TABLE_MAX_CELLS=10000
PARSER_IMAGE_EXTRACTION_ENABLED=true
PARSER_IMAGE_MAX_PER_PAGE=20
PARSER_ASSET_PERSISTENCE_ENABLED=true
PARSER_SOURCE_RETENTION_ENABLED=true
PARSER_ASSET_STORAGE_DIR=data/document-assets
PARSER_ASSET_DPI=144
PARSER_ASSET_MAX_PER_DOCUMENT=120
PARSER_ASSET_MAX_TOTAL_MB=512
PARSER_ASSET_RENDER_OCR_PAGES=true
PARSER_OCR_HANDWRITING_CONFIDENCE=0.62
PARSER_OCR_MODEL_VERSION=PP-OCRv5
PARSER_TABLE_MODEL_VERSION=PP-StructureV3
PARSER_PIPELINE_VERSION=5

# PaddleX model cache in the container's persisted model-cache volume.
PADDLE_PDX_CACHE_HOME=/home/appuser/.cache/paddlex
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=true

# Optional multimodal visual indexing. It remains off until a vision-capable
# OpenAI-compatible endpoint and credentials are explicitly configured.
VISUAL_ENABLED=false
VISUAL_PROVIDER=openai_compatible
VISUAL_API_KEY=
VISUAL_BASE_URL=
VISUAL_MODEL=
VISUAL_DETAIL=low
VISUAL_MAX_ASSETS_PER_DOCUMENT=24
VISUAL_MAX_ASSET_BYTES=8388608
VISUAL_MAX_TOKENS=500
VISUAL_REQUEST_TIMEOUT_SECONDS=60
VISUAL_PROMPT_VERSION=v1

# RAPTOR
RAPTOR_RAPTOR_LEVELS=3
RAPTOR_RAPTOR_THRESHOLD=0.7
RAPTOR_SUMMARY_MODEL=
RAPTOR_MAX_NODES=2000
RAPTOR_SUMMARY_CONCURRENCY=4

# GraphRAG
GRAPH_GRAPH_ENABLED=true
GRAPH_ENTITY_EXTRACTION_MODEL=
GRAPH_COMMUNITY_SUMMARY_MODEL=
GRAPH_MAX_ENTITIES_PER_DOC=20
GRAPH_MIN_COMMUNITY_SIZE=3
GRAPH_EXTRACTION_CHAR_BUDGET=12000
GRAPH_GRAPH_EMBEDDING_DIM=1024
GRAPH_GRAPH_STORE_PATH=data/graphrag.json
GRAPH_MAX_TOTAL_ENTITIES=10000
GRAPH_MAX_COMMUNITIES=500
GRAPH_SUMMARY_CONCURRENCY=4

# Agent
AGENT_MAX_ITERATIONS=3
AGENT_MAX_SEARCH_STEPS=3
AGENT_CRITIC_THRESHOLD=7.0
AGENT_MAX_REFINE_ROUNDS=1
AGENT_SUBTASK_TIMEOUT=30
AGENT_RESEARCH_TIMEOUT=180
AGENT_MAX_SUBTASKS=5
AGENT_MAX_TOOL_CALLS_PER_ROUND=4
AGENT_MAX_TOOL_CALLS_TOTAL=12
AGENT_MAX_CONCURRENT_RESEARCH=2
AGENT_MAX_CONCURRENT_SUBTASKS=4
AGENT_MAX_CONCURRENT_TOOL_CALLS=8
AGENT_QUEUE_TIMEOUT=30
AGENT_SSE_HEARTBEAT_SECONDS=10
AGENT_STREAM_CHUNK_SIZE=512

# Cache
CACHE_REDIS_URL=redis://localhost:6377
CACHE_CACHE_TTL=3600
CACHE_EMBEDDING_CACHE_SIZE=1000

# Memory
MEMORY_WORKING_CAPACITY_TOKENS=8000
MEMORY_CHARS_PER_TOKEN=4
MEMORY_MAX_EPISODES=200
MEMORY_EPISODIC_TTL_SECONDS=2592000
MEMORY_MAX_EPISODE_CHARS=100000
MEMORY_MAX_SEMANTIC_FACTS=500
MEMORY_MAX_SEMANTIC_PATTERNS=1000
MEMORY_MAX_SEMANTIC_FACT_CHARS=50000
MEMORY_SEMANTIC_RETENTION_DAYS=30
MEMORY_SEMANTIC_MAX_FILE_BYTES=52428800

# PostgreSQL and encryption
POSTGRES_USER=mindforge
# Replace this placeholder before any non-local deployment.
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=mindforge
POSTGRES_PORT=5432
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777
# Required by the application. Keep it consistent with the PostgreSQL values above.
DATABASE_URL=postgresql://mindforge:change-this-password@localhost:5432/mindforge
APP_SECRET=

# Docker infrastructure and container-internal addresses
APP_UID=1000
APP_GID=1000
PYTHON_REQUIREMENTS_FILE=requirements-cpu.lock
GPU_EMBEDDING_BATCH_SIZE=32
GPU_DEVICE_0=/dev/nvidia0
GPU_DEVICE_CTL=/dev/nvidiactl
GPU_DEVICE_UVM=/dev/nvidia-uvm
GPU_DEVICE_UVM_TOOLS=/dev/nvidia-uvm-tools
GPU_LIBCUDA_PATH=/usr/lib/x86_64-linux-gnu/libcuda.so.1
GPU_LIBNVIDIA_ML_PATH=/usr/lib/x86_64-linux-gnu/libnvidia-ml.so.1
DOCKER_API_BIND_ADDRESS=127.0.0.1
DOCKER_INFRA_BIND_ADDRESS=127.0.0.1
QDRANT_IMAGE=docker.m.daocloud.io/qdrant/qdrant:v1.18.3@sha256:0bd98fa7977f1e75694779359ca4e212822e5a71334e28421182f72f209d5286
QDRANT_VOLUME_NAME=mindforge_qdrant_v118_data
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2
REDIS_PORT=6377
REDIS_MAXMEMORY=512mb
CONTAINER_API_PORT=8000
CONTAINER_API_HOST=0.0.0.0
CONTAINER_POSTGRES_HOST=postgres
CONTAINER_POSTGRES_PORT=5432
CONTAINER_QDRANT_HOST=qdrant
CONTAINER_QDRANT_HTTP_PORT=6333
CONTAINER_REDIS_HOST=redis
CONTAINER_REDIS_PORT=6379
CONTAINER_DATA_DIR=/app/data
CONTAINER_TRACES_DIR=/app/data/traces
CONTAINER_SEMANTIC_MEMORY_DIR=/app/data/semantic-memory
CONTAINER_BM25_INDEX_DIR=/app/data/bm25
CONTAINER_GRAPH_STORE_PATH=/app/data/graphrag.json

# Frontend (Vite reads this project-root .env)
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_API_TIMEOUT_MS=30000
VITE_RESEARCH_TIMEOUT_MS=900000
VITE_STREAM_FLUSH_MS=50
VITE_STREAM_MARKDOWN_INTERVAL_MS=350
VITE_MAX_STREAMED_ANSWER_CHARS=1000000
VITE_MAX_SSE_BYTES=5242880
VITE_MAX_SSE_EVENT_CHARS=2000000

# Local startup
STARTUP_READY_ATTEMPTS=60
STARTUP_READY_INTERVAL_SECONDS=1

# QA dataset generation
QA_OUTPUT_DIR=data/qa
QA_MODEL=
QA_BATCH_SIZE=15
QA_CONCURRENCY=3
QA_CLIENT_MAX_RETRIES=5
QA_REQUEST_ATTEMPTS=3
QA_TEMPERATURE=0.7
QA_MAX_TOKENS=8192
QA_RETRY_BASE_SECONDS=3

# Web search
TAVILY_API_KEY=

# Observability
OBSERVABILITY_LANGFUSE_PUBLIC_KEY=
OBSERVABILITY_LANGFUSE_SECRET_KEY=
OBSERVABILITY_LANGFUSE_HOST=https://cloud.langfuse.com
OBSERVABILITY_ENABLE_TRACING=true
OBSERVABILITY_CAPTURE_CONTENT=false
OBSERVABILITY_MAX_RECORD_CHARS=20000
OBSERVABILITY_MAX_TRACE_FILE_BYTES=5242880
OBSERVABILITY_TRACE_RETENTION_DAYS=7

# Code sandbox
SANDBOX_SANDBOX_TIMEOUT=15
SANDBOX_TEMP_DIR=data/sandbox-tmp
SANDBOX_MAX_OUTPUT_LENGTH=5000
SANDBOX_MAX_CODE_LENGTH=50000
SANDBOX_MAX_VARS_BYTES=100000
SANDBOX_MEMORY_MB=512
SANDBOX_ALLOWED_MODULES=["math","json","collections","itertools","datetime","typing","re","statistics","decimal","fractions","numpy","pandas","scipy","sklearn"]
